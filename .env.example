# Pricing (Philippine Peso)
BLACK_AND_WHITE_PRICE=3.0
COLOR_PRICE=5.0
# Flat fee (whole pesos) for the digital copy of a scan (download/email). Default
# until Kiosk Admin sets its own value.
SCAN_DIGITAL_FEE=5

# Printer
PRINTER_NAME=Your_CUPS_Printer_Name   # the CUPS queue name from `lpstat -p` (HP_Smart_Tank on the kiosk)

# Sheets left at or below which the operator gets a low-paper SMS (optional, default
# shown). The kiosk stops taking customers at 3 sheets regardless.
LOW_PAPER_ALERT_SHEETS=10

# Inactivity timeout (managers/timeout_manager.py). With this many seconds left on a
# screen a "Still there?" prompt appears, and its button adds the extension (optional,
# defaults shown). Any tap, coin, bill or QR read restarts the full time.
TIMEOUT_WARNING_SECONDS=15
TIMEOUT_EXTEND_SECONDS=30

# Ink (managers/ink_supply.py). Low ink only SMSes the operator, once per tank until it is
# topped up; customers are blocked only when an admin enters 0% for a tank in Kiosk Admin.
# The yields (pages one bottle prints at standard coverage) scale the ink estimate. Defaults are
# HP's Smart Tank 670 data sheet: GT53XL black ~6,200 pages, GT52 colour ~9,100 per bottle.
INK_LOW_ALERT_PERCENT=20
INK_YIELD_BLACK_PAGES=6200
INK_YIELD_COLOR_PAGES=9100

# Additional printer settings
PRINTER_TIMEOUT=30
PRINTER_RETRY_ATTEMPTS=3

# System settings
DEFAULT_COLOR_MODE=Black and White
MAX_COPIES=99
MIN_COPIES=1

# Analysis settings for color reading
PDF_ANALYSIS_DPI=150
COLOR_TOLERANCE=15
PIXEL_COUNT_THRESHOLD=200

# SMS alerts — phone number to receive error/status notifications
PHONE_NUMBER=09XXXXXXXXX

# PIN required to open the admin dialog (screens/dialogs/pin_dialog/). Optional,
# defaults to 1234 if unset — override this before deploying to a real kiosk.
ADMIN_PIN=1234
# Wrong PINs in a row before the PIN dialog locks, and how long it stays locked
# (minutes). Only PIN entry is blocked. Both optional (5 and 5).
ADMIN_PIN_MAX_ATTEMPTS=5
ADMIN_PIN_LOCKOUT_MINUTES=5

# Kiosk model: picks the acceptor and hopper GPIO pins (KIOSK_MODEL_PINS in
# SSP/config.py). 'old' (default) or 'new'.
KIOSK_MODEL=old

# Hardware GPIO pins. Optional: uncomment one only to override the kiosk model's pin
# for a single kiosk. Values shown are the 'old' model's.
# COIN_PIN=12       # Coin acceptor pulse input ('new': 17)
# BILL_PIN=18       # Bill acceptor pulse input
# COIN_INHIBIT_PIN=22  # Coin acceptor enable (active high: HIGH=enabled, LOW=disabled)
# BILL_INHIBIT_PIN=23  # Bill acceptor enable (active low: LOW=enabled, HIGH=disabled)

# Coin hoppers: coin-out sensor inputs and motor enables (active low). Optional, as above.
# HOPPER_A_SIGNAL_PIN=9    # ₱1 hopper ('new': 26)
# HOPPER_A_ENABLE_PIN=24
# HOPPER_B_SIGNAL_PIN=26   # ₱5 hopper ('new': 9)
# HOPPER_B_ENABLE_PIN=25

# Coin pulse noise filtering (optional, defaults shown). COIN_PULSE_FILTER=false
# falls back to plain falling-edge counting, for checking the wiring alone.
COIN_PULSE_FILTER=true
COIN_GLITCH_FILTER_US=5000  # ignore coin-pin level changes shorter than this
COIN_PULSE_MIN_MS=10        # count only low pulses between MIN and MAX ms wide
COIN_PULSE_MAX_MS=150

# Bill pulse noise filtering, the same way (optional, defaults shown). Real bill
# pulses are ~50 ms; the line also carries sub-0.1 ms spikes that added pulses.
BILL_PULSE_FILTER=true
BILL_GLITCH_FILTER_US=5000
BILL_PULSE_MIN_MS=20
BILL_PULSE_MAX_MS=150

# Set to true to skip GPIO, CUPS, and modem hardware (for laptop development)
SIM_MODE=true

# Directory scanned for PDFs as a fake USB drive when SIM_MODE=true (optional, default shown)
SIM_USB_DIR=SSP/database/sim_usb_drive

# Scanner module (managers/scanner.py) — flatbed scanning via sane-airscan.
# On the kiosk use escl:http://localhost:60000, the ipp-usb port the
# printer is on, which works for any HP Smart Tank model. Run `scanimage -L`
# to see the actual names (docs/KIOSK_PI_SETUP.md step 8). Leave blank for
# SIM_MODE development (SimScanner is used instead). All optional, defaults
# shown.
SCANNER_DEVICE=
SCANNER_DPI=200
# Gray (default, ~9 s a page) or Color (~20 s). The scanner screen lets the customer switch.
SCANNER_MODE=Gray
SCANNER_TIMEOUT=60
SIM_SCANNER_DIR=SSP/database/sim_scanner_pages
SIM_SCANNER_PAGE_COUNT=3
SCAN_UPLOAD_DIR=SSP/database/scan_uploads

# FastAPI backend (SSP/webapp) — must be false in production deployments
API_DOCS_ENABLED=true

# Wi-Fi upload portal (webapp/routers/upload.py) — both optional, defaults shown
WIFI_UPLOAD_DIR=SSP/database/wifi_uploads
MAX_UPLOAD_SIZE_MB=25

# Port the Wi-Fi portal listens on. The hotspot firewall opens exactly this
# port on the hotspot interface (scripts/setup_hotspot.py). Optional, default shown.
WIFI_PORTAL_PORT=8000

# Plain-HTTP port of the captive-portal probe responder (ADR 0008). The hotspot
# firewall redirects the hotspot's port 80 here, so phones and laptops open the
# upload page on their own when they join. Started only when
# WIFI_HOTSPOT_ENABLED=true. Optional, default shown.
WIFI_CAPTIVE_PORT=8080

# Kiosk hotspot (scripts/setup_hotspot.py, ADR 0007/0008): hostapd + dnsmasq, open
# network, captive-portal detection but no splash page. Read by the setup script at install time:
#   sudo python3 scripts/setup_hotspot.py
# WIFI_HOTSPOT_ENABLED=true enables hostapd/dnsmasq; false disables them (the
# firewall stays on). KIOSK_ID is the last part of print.<domain>/k/<KIOSK_ID>.
# PORTAL_HOSTNAME uses a reserved .example placeholder until the domain is bought.
# WIFI_HOTSPOT_ADDRESS is the Pi's own address and must be the first host of
# its subnet; DHCP hands out the rest.
KIOSK_ID=
WIFI_HOTSPOT_ENABLED=true
WIFI_HOTSPOT_INTERFACE=wlan0
WIFI_HOTSPOT_SSID=AIO-SPARK
WIFI_HOTSPOT_COUNTRY=PH
WIFI_HOTSPOT_CHANNEL=6
WIFI_HOTSPOT_ADDRESS=10.3.141.1/24
PORTAL_HOSTNAME=print.aio-spark.example

# Wi-Fi portal TLS (project_objectives.txt module 5). Generate the pair with:
#   python scripts/generate_tls_cert.py
# HTTPS is used only when BOTH files exist; otherwise the portal serves plain
# HTTP (so a fresh checkout runs with no cert). Paths are relative to repo root.
WIFI_TLS_CERTFILE=certs/cert.pem
WIFI_TLS_KEYFILE=certs/key.pem

# Email intake (managers/adapters/email_adapter.py). Configured for the real
# dedicated Gmail account: fill EMAIL_USER / EMAIL_PASSWORD with the address and
# a 16-char Gmail App Password (the Google account needs 2-Step Verification on).
# See docs/SETUP.md "Email + Wi-Fi end-to-end" for the full walkthrough.
#
# For offline dev with no Google account, point at the greenmail dev server
# (managers/adapters/greenmail/docker-compose.yml) instead — swap in:
#   EMAIL_IMAP_HOST=127.0.0.1   EMAIL_IMAP_PORT=3143
#   EMAIL_SMTP_HOST=127.0.0.1   EMAIL_SMTP_PORT=3025
#   EMAIL_USE_SSL=false   EMAIL_USER=test@example.com   EMAIL_PASSWORD=test
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USE_SSL=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_MAILBOX=INBOX
EMAIL_SUBJECT_KEYWORD=DEMO_TRIGGER
EMAIL_POLL_INTERVAL_SECONDS=20
EMAIL_UPLOAD_DIR=SSP/database/email_uploads
EMAIL_MAX_ATTACHMENT_SIZE_MB=25

# Admin Dashboard (SSP/admin_dashboard) — a separate, authenticated FastAPI
# process, sibling to the Wi-Fi portal, never spawned by main_app.py. See
# docs/adr/0002-admin-dashboard-auth-and-remote-access-architecture.md.
# Start it with `make run-admin-dashboard`. Both optional, defaults shown.
ADMIN_DASHBOARD_PORT=8100
# Cookie-signing secret for the login session — override before deploying to
# a real kiosk; the default below is dev-only and not a secret.
ADMIN_DASHBOARD_SECRET_KEY=dev-insecure-secret-change-me
# Sliding inactivity timeout for a login session, and how long an account
# locks out after 5 consecutive failed login attempts.
ADMIN_DASHBOARD_SESSION_HOURS=10
ADMIN_DASHBOARD_LOCKOUT_MINUTES=15

# QR reader (managers/qr_reader.py) — the kiosk's fixed 2D reader, run as a USB
# serial port (see docs/adr/0004-qr-reader-serial-mode-and-untrusted-payloads.md).
# Set to the reader's port, e.g. /dev/ttyACM0 on the Pi or /dev/cu.usbmodem1101
# on a Mac. Leave blank for no reader (typed codes only).
QR_READER_PORT=

# Touchscreen UI scale (ui/scaling.py). Blank or "auto" scales to the screen
# height (1.35 on a 1080-tall panel, 1 on 800 or less). A number such as 1.5
# forces that scale; screens taller than ~800px at 1x then overflow on 1080.
UI_SCALE=
