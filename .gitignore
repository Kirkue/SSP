# Virtual environment
.venv/

# Python bytecode cache
__pycache__/
*.pyc

# macOS
.DS_Store

# Self-signed TLS cert/key generated by scripts/generate_tls_cert.py
certs/
*.pem

# Uploaded/extracted files awaiting pickup
SSP/database/wifi_uploads/
SSP/database/email_uploads/

# Fake USB drive directory seeded by SIM_MODE (managers/usb_file_manager.py)
SSP/database/sim_usb_drive/

# The kiosk's real SQLite DB and any SIM_MODE demo-data variant of it
# (e.g. the Admin Dashboard's seeded fixture DB) — never committed.
SSP/database/*.db

# Local config with secrets — copy .env.example to .env and fill it in
.env

# Claude Code worktrees (each is its own checkout; never commit them)
.claude/worktrees/

# Reference renders from `make screenshots`
screenshots/
# Printed how-to sheet from scripts/make_intake_sheet.py
intake_sheet.pdf
